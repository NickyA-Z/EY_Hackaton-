# Copy this file to location_agent/.env and fill it in. .env is git-ignored - never put keys in THIS file.
#
# --- Option A: Claude (Anthropic API) -----------------------------------------
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
LLM_API_KEY=                 # your Anthropic API key (or leave empty to use ANTHROPIC_API_KEY / `ant auth login`)
LLM_EFFORT=medium            # Claude only: low | medium | high | xhigh | max (more effort = more thinking tokens = more cost)
#
# --- Option B: OpenRouter (free-tier models available) ------------------------
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# LLM_API_KEY=                                        # your OpenRouter key (sk-or-...)
# LLM_EXTRA_BODY={"reasoning": {"enabled": true}, "provider": {"only": ["nvidia"], "allow_fallbacks": false}}
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=16000                                # reasoning tokens count too - give reasoning models more room
#
# --- Option C: an open model behind ngrok (any OpenAI-compatible server) ------
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://<your-id>.ngrok-free.app/v1   # Ollama: http://localhost:11434/v1
# LLM_MODEL=llama3.1:70b                              # the model name your server serves
# LLM_API_KEY=                                        # if your endpoint needs one
# LLM_TEMPERATURE=0.2
#
# --- Options for any OpenAI-compatible endpoint (B, C) -------------------------
# LLM_EXTRA_BODY = extra JSON fields merged into the request body (provider-specific)
# LLM_JSON_MODE=false  -> don't send response_format (for models that reject JSON mode)
#
# --- Both ----------------------------------------------------------------------
# Ceiling on the answer length, not a charge: you pay only for tokens actually generated.
# The JSON answer is ~1,500-2,500 tokens and thinking/reasoning also counts as output,
# so values below ~4,000 cut the answer off. 8,000 leaves safe headroom (16,000 for reasoning models).
LLM_MAX_TOKENS=8000
